# ==========================================
# CarePlan Generator - 环境变量配置
# ==========================================
# LLM API Configuration
# LLM API configuration (optional when the local mock is enabled).
# ==========================================
# OpenAI API Key - 请替换为您的实际 API Key
# 获取方法：访问 https://platform.openai.com/api-keys
LLM_API_KEY=your_openai_api_key_here
# OpenAI API URL（可选，默认使用 OpenAI）
# 如果使用 Claude 或其他 LLM，需要修改此 URL
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MOCK_ENABLED=true

# For host-based Spring Boot runs. Root Compose sets its own Docker addresses.
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/careplan
KEYCLOAK_JWK_SET_URI=http://localhost:8081/realms/careplan/protocol/openid-connect/certs
CAREPLAN_ALLOWED_ORIGINS=http://localhost:3000
METRICS_USER=monitor
METRICS_PASSWORD=local-monitor-only
DB_USERNAME=careplan_user
DB_PASSWORD=careplan_password
# ==========================================
# 使用说明
# ==========================================
# 1. 复制此文件为 .env
#    Windows: copy .env.example .env
#    Mac/Linux: cp .env.example .env
#
# 2. 编辑 .env 文件，替换 your_openai_api_key_here 为真实的 API Key
#
# 3. 运行项目：.\run-local.bat（Windows）
#
# ==========================================
# 数据库配置说明
# ==========================================
# 数据库配置已在 docker-compose.yml 中固定，无需在此配置
# 
# TablePlus 连接信息：
# - Host: localhost
# - Port: 5432
# - User: careplan_user
# - Password: careplan_password
# - Database: careplan
# ==========================================
