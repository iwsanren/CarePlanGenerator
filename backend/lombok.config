# Applies to everything under backend/ and stops Lombok from reading configuration in parent directories.
config.stopBubbling = true

# Mark Lombok-generated getters, setters, equals/hashCode, constructors and so on with @lombok.Generated.
# JaCoCo skips code carrying an annotation named *Generated, so generated code does not count towards coverage.
# The current Lombok version already does this by default; stating it here keeps the coverage numbers stable
# if that default ever changes. Without the annotation, branch coverage drops from about 70% to about 27%.
lombok.addLombokGeneratedAnnotation = true
